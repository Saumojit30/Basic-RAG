# --- LLM (any OpenAI-compatible API; Groq by default) ---
# Get a free key at https://console.groq.com/keys.
# Leave GROQ_API_KEY empty to run the pipeline in MOCK MODE
# (fake embeddings + echo answers, no cost, no external calls).
GROQ_API_KEY=

# OPENAI_API_KEY works too as a fallback for other OpenAI-compatible
# providers (OpenAI, Together, Ollama proxy, ...).

# Groq defaults - no need to touch these unless you switch providers:
OPENAI_BASE_URL=https://api.groq.com/openai/v1
EMBEDDING_MODEL=nomic-embed-text-v1_5
CHAT_MODEL=llama-3.3-70b-versatile

# --- Retrieval ---
TOP_K=4
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- API ---
# Comma-separated list of allowed frontend origins ("*" = allow all)
CORS_ORIGINS=*
